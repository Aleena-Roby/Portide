# ==============================================================================
# Application Configuration
# ==============================================================================
SECRET_KEY="your-secret-key-here"
DEBUG="True"
APP_URL="http://localhost:5173"

# ==============================================================================
# Supabase / Cloud PostgreSQL (Recommended for Production)
# ==============================================================================
# In Supabase -> Project Settings -> Database -> Connection string (URI)
# Use Transaction Pooler (port 6543) or Session Pooler / Direct (port 5432):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# ==============================================================================
# Local PostgreSQL / Docker Configuration (Fallback if DATABASE_URL not set)
# ==============================================================================
POSTGRES_DB="portide_db"
POSTGRES_USER="portide_user"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_HOST="postgres"
POSTGRES_PORT="5432"

# ==============================================================================
# Frontend Environment Variable (Set in Vercel Project Settings)
# ==============================================================================
# In Vercel -> Settings -> Environment Variables:
# VITE_API_BASE_URL="https://your-backend-service.com"

# ==============================================================================
# Email Configuration (Gmail SMTP)
# ==============================================================================
EMAIL_BACKEND="django.core.mail.backends.smtp.EmailBackend"
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"
EMAIL_HOST_USER="portide.system@gmail.com"
EMAIL_HOST_PASSWORD="your-gmail-app-password"
DEFAULT_FROM_EMAIL="portide.system@gmail.com"
